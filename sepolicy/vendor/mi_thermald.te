# mi_thermald - Xiaomi thermal daemon policy
type mi_thermald, domain;
type mi_thermald_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(mi_thermald)

# Types (Note: sysfs_thermal_sram and thermal_core_data_file are declared in common Mediatek policy)
type sysfs_battery_supply, fs_type, sysfs_type;
type sysfs_led, fs_type, sysfs_type;
type sys_thermal_market_download_limit, fs_type, sysfs_type;
type sys_thermal_wifi_limit, fs_type, sysfs_type;
type vendor_thermal_normal_prop, property_type;

# Capabilities
allow mi_thermald self:capability { fsetid sys_boot chown fowner };
allow mi_thermald self:capability2 { wake_alarm block_suspend };

# CPU and system files
allow mi_thermald sysfs_devices_system_cpu:file rw_file_perms;

# Thermal files
allow mi_thermald sysfs_thermal_sram:file rw_file_perms;
allow mi_thermald sysfs_thermal_sram:dir search;

allow mi_thermald sysfs_thermal:dir r_dir_perms;
allow mi_thermald sysfs_thermal:file rw_file_perms;
allow mi_thermald sysfs_thermal:lnk_file r_file_perms;

allow mi_thermald sysfs:dir r_dir_perms;
allow mi_thermald sysfs:file rw_file_perms;
allow mi_thermald sysfs:lnk_file r_file_perms;

# Leds files
allow mi_thermald sysfs_leds:dir r_dir_perms;
allow mi_thermald sysfs_leds:file r_file_perms;
allow mi_thermald sysfs_leds:lnk_file r_file_perms;

allow mi_thermald sysfs_led:file rw_file_perms;

# Battery / charger files
allow mi_thermald sysfs_batteryinfo:dir r_dir_perms;
allow mi_thermald sysfs_batteryinfo:file rw_file_perms;
allow mi_thermald sysfs_batteryinfo:lnk_file r_file_perms;

allow mi_thermald sysfs_battery_supply:dir r_dir_perms;
allow mi_thermald sysfs_battery_supply:file rw_file_perms;
allow mi_thermald sysfs_battery_supply:lnk_file r_file_perms;

# Custom thermal limits (sysfs files)
allow mi_thermald sys_thermal_market_download_limit:file rw_file_perms;
allow mi_thermald sys_thermal_wifi_limit:file rw_file_perms;

# Properties
set_prop(mi_thermald, default_prop)
set_prop(mi_thermald, vendor_thermal_normal_prop)

# Sysfs_therm access
allow mi_thermald sysfs_therm:dir r_dir_perms;
allow mi_thermald sysfs_therm:file rw_file_perms;

# Thermal data files (labeled thermal_core_data_file in common Mediatek policy)
allow mi_thermald thermal_core_data_file:dir create_dir_perms;
allow mi_thermald thermal_core_data_file:file create_file_perms;
